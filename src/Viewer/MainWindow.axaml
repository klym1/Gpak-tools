<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Viewer"
        x:Class="Viewer.MainWindow"
        Title="GP Viewer"
        Width="1112" Height="620"
        DragDrop.AllowDrop="True">

  <Grid RowDefinitions="Auto,*,Auto" Margin="12" RowSpacing="12">

    <WrapPanel Grid.Row="0" Orientation="Horizontal" ItemSpacing="20" LineSpacing="8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="OpenButton" Content="Open…"
                ToolTip.Tip="Open the game's All.gsc, a folder extracted from it, or a sprite inside one (or drop one on the window)" />
        <TextBlock x:Name="FileNameText" VerticalAlignment="Center" FontWeight="SemiBold" MinWidth="120" />
      </StackPanel>

      <!-- Shown once game data with units is open -->
      <StackPanel x:Name="UnitPanel" Orientation="Horizontal" Spacing="8" IsVisible="False">
        <TextBlock Text="Add unit" VerticalAlignment="Center" />
        <ComboBox x:Name="UnitBox" Width="260" MaxDropDownHeight="520" IsTextSearchEnabled="True"
                  PlaceholderText="Pick a unit…" ToolTip.Tip="Pick a unit to put it on the field, in the picked color" />
        <Button x:Name="RemoveUnitsButton" Content="Remove" IsEnabled="False"
                ToolTip.Tip="Remove the selected units from the field (Delete)" />
        <Button x:Name="AttackButton" Content="Attack" IsEnabled="False"
                ToolTip.Tip="The selected units attack once where they stand" />
        <Button x:Name="KillButton" Content="Kill" IsEnabled="False"
                ToolTip.Tip="The selected units die and leave the field" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="PlayButton" Content="▶ Play" MinWidth="84" ToolTip.Tip="Run or pause the field" />
        <TextBlock Text="FPS" VerticalAlignment="Center" />
        <NumericUpDown x:Name="FramesPerSecond" Minimum="1" Maximum="60" Increment="1" Value="25" FormatString="0" Width="108"
                       ToolTip.Tip="Animation frames per second; units walk one step per frame" />
        <CheckBox x:Name="SoundBox" Content="Sound" IsChecked="True" ToolTip.Tip="Play the units' sounds (drums, hooves)" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Color" VerticalAlignment="Center" />
        <ComboBox x:Name="PlayerColorBox" MinWidth="112" ToolTip.Tip="Player color of the selected units and of units added next">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="local:PlayerColorOption">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="14" Height="14" CornerRadius="2" Background="{Binding Swatch}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
    </WrapPanel>

    <!-- The field: units stand with their feet (anchor) at their positions and walk where they are sent -->
    <Panel Grid.Row="1" x:Name="ViewArea">
      <Canvas x:Name="Field" Focusable="True" Background="#5D7044" ClipToBounds="True">
        <!-- Units (image, selection ring, target marker) are added in code; images are ordered front to back by their feet. -->
        <Rectangle x:Name="SelectionRectangle" Stroke="#9CFF57" StrokeThickness="1" Fill="#269CFF57"
                   IsVisible="False" IsHitTestVisible="False" ZIndex="100000" />
        <TextBlock x:Name="FieldHint" Canvas.Left="10" Canvas.Top="8" Foreground="#E8F0DC" IsHitTestVisible="False" ZIndex="100001" />
      </Canvas>
    </Panel>

    <!-- Loading progress and errors -->
    <TextBlock Grid.Row="2" x:Name="StatusText" TextWrapping="Wrap" Foreground="Gray" />
  </Grid>
</Window>
